{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proxykit-gateway",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-05",
  "workers_dev": false,
  "preview_urls": false,
  "keep_vars": true,
  "limits": { "cpu_ms": 3000 },
  "vars": { "ALLOW_URL_TOKENS": "false" },
  "secrets": { "required": ["GITHUB_READ_TOKEN", "DEVICE_AUTH"] },
  "observability": {
    "enabled": true,
    "redact_query_string": true,
    "logs": { "enabled": true, "invocation_logs": false },
    "traces": { "enabled": false },
  },
}
